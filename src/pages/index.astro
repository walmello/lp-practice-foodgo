---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-image.png';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>

	<div class="content">
		<div class="container">
			<div class="navbar">
				<img src="foodgo-logo.svg" alt="">
				<ul class="navlinks-group">
					<li><a href="#">Our Products</a></li>
					<li><a href="#">Services</a></li>
					<li><a href="#">Pricing</a></li>
					<li><a href="#">Clients</a></li>
					<li><a href="#">Helpdesk</a></li>
				</ul>
				<a class="button">
					Get the app →
				</a>
			</div>
			<div class="hero">
				<div class="hero-content">
					<p style="font-weight: bold;">Food Made with <span class="text-orange">❤</span> For you</p>
					<h1>
						Satisfy your 
						hunger, with 
						<span class="text-orange">ONE CLICK</span>
					</h1>
					<p class="subtitle">
						Find nearest restaurants and groceries near you, don't keep 
						your hunger waiting! 
					</p>
					<div class="button-group">
						<a href="" class="button button-cta button-outline">
							What we do?
						</a>
						<a href="" class="button button-cta">
							Get the app
						</a>
					</div>
				</div>
				<div>
					<Image class="hero-image" src={heroImage} alt="Women thinking on what to eat"></Image>
				</div>
			</div>	
		</div>
		
		<img class="waves" src="waves.svg" alt="" srcset="">
	</div>
</Layout>

<style>
	/* Register your custom font family and tell the browser where to find it. */
	@font-face {
		font-family: 'Caprasimo';
		src: url('/fonts/Caprasimo-Regular.ttf') format('woff');
		font-weight: normal;
		font-style: normal;
		font-display: swap;
	}
	
	@font-face {
		font-family: 'Inter';
		src: url('/fonts/Inter-VariableFont_opsz,wght.ttf') format('woff');
		font-weight: normal;
		font-style: normal;
		font-display: swap;
	}

	:root {
		--black: #2A0F0B;
		--white: #fff;
		--light: #F3F1EF;
		--orange: #F05236;
	}
	
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}
	
	body {
		font-family: Inter;
		background-color: var(--light);
		overflow-x: hidden;
	}
	
	.content {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 100vh;
	}
	
	.waves {
		width: 100%;
	}
	
	.container {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}
	
	.navbar {
		display: flex;
		justify-content: space-between;
		padding: 1rem 0;
	}
	
	.navlinks-group {
		list-style: none;
		padding: 0;
		display: flex;
		gap: 2rem;
		align-items: center;
	}
	
	a {
		font-weight: bold;
		color: var(--black);
		text-decoration: none;
	}
	
	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
	}
	
	.hero-content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 2rem;
	}
	
	.hero-content > * {
		margin: 0;
	}
	
	.button-group {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	
	.button {
		background-color: var(--black);
		padding: 1rem 2rem;
		color: var(--white);
		border-radius: 999rem;
		border: 2px solid var(--black);
	}
	
	.button.button-cta {
		background-color: var(--orange);
		border: 2px solid var(--orange);
	}
	
	.button.button-outline{
		color: var(--orange);
		background-color: transparent;
		border: 2px solid var(--orange);
	}
	
	h1 {
		font-family: Caprasimo, serif;
		font-weight: normal;
		font-size: 4rem;
	}
	
	.hero-image {
		width: 100%;
		object-fit: contain;
	}
	
	@media (max-width: 1200px) {
		h1 {
			font-size: 3rem;
		}
		
		
	}
	
	@media (max-width: 1000px) {
		.hero {
			display: flex;
			flex-direction: column;
		}
		
		.navbar ul {
			display: none;
		}
		
		.button-group {
			flex-direction: column;
		}
		
		.button-group * {
			width: 100%;
		}
	}
	.subtitle {
		font-size: 1.5rem;
	} 
	
	.text-orange {
		color: var(--orange);
	}
</style>